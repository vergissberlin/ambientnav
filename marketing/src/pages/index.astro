---
import '../styles/theme.css';
import HeroVisual from '../components/HeroVisual.astro';
import SystemDiagram from '../components/SystemDiagram.astro';
import logoLockup from '../assets/logo-lockup.svg?url';

const repoUrl = 'https://github.com/vergissberlin/ambientnav';
const docsUrl = 'https://vergissberlin.github.io/ambientnav/getting-started/';
const year = new Date().getFullYear();

const features = [
  {
    title: 'Navigation Lighting',
    body: 'The front LED strip mirrors your phone’s turn-by-turn navigation — sweep left before a left turn, sweep right for a right turn, pulse forward when continuing straight.',
  },
  {
    title: 'Parking Aid',
    body: 'Three ultrasonic sensors at the rear feed a live distance bar. It narrows and shifts from green to red as you approach an obstacle.',
  },
  {
    title: 'Open & Offline',
    body: 'Built on OpenStreetMap and the Valhalla routing engine — no subscription, no cloud lock-in, and it works offline once map tiles are cached.',
  },
  {
    title: 'Wireless Architecture',
    body: 'The phone talks to the front ESP32 over Bluetooth LE. Front and rear ESP32s talk to each other over Bluetooth Classic — no wiring between the two boards.',
  },
];

const scenarios = [
  { scenario: 'Turn left', effect: 'Front strip sweeps left, amber' },
  { scenario: 'Turn right', effect: 'Front strip sweeps right, amber' },
  { scenario: 'Continue straight', effect: 'Front strip pulses forward, white' },
  { scenario: 'Reversing — obstacle far', effect: 'Full rear bar, green' },
  { scenario: 'Reversing — obstacle close', effect: 'Rear bar narrows, amber → red' },
  { scenario: 'Idle', effect: 'Slow breathing, configurable color' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>AmbientNav — Ambient LED Navigation for Your Car</title>
    <meta
      name="description"
      content="AmbientNav turns addressable LED strips into a real-time navigation guide and parking-proximity display. Open-source, DIY-built with two ESP32 boards and a Flutter app."
    />
    <meta property="og:title" content="AmbientNav — Ambient LED Navigation for Your Car" />
    <meta
      property="og:description"
      content="Navigation-guided ambient lighting and parking assistance for your vehicle. Open-source, no subscription, no cloud lock-in."
    />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="AmbientNav home">
        <img src={logoLockup} alt="AmbientNav" height="28" />
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="#features">Features</a>
        <a href="#how-it-works">How it works</a>
        <a href={docsUrl}>Docs</a>
        <a href={repoUrl}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Open-source · DIY automotive hardware</p>
        <h1>Navigation-guided ambient lighting for your dashboard.</h1>
        <p class="hero-sub">
          AmbientNav mirrors your phone’s turn-by-turn navigation and live parking distance on
          addressable LED strips — inspired by the VW ID.3 ambient lighting, built on two ESP32
          boards and a Flutter app you run yourself.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={repoUrl}>View on GitHub</a>
          <a class="btn btn-secondary" href={docsUrl}>Read the Docs</a>
        </div>
      </section>

      <HeroVisual lang="en" />

      <section id="features" class="features">
        <h2>What is AmbientNav?</h2>
        <div class="feature-grid">
          {features.map((f) => (
            <article class="feature-card">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="how-it-works" class="how-it-works">
        <h2>How it works</h2>
        <p class="section-sub">
          The phone talks over Bluetooth LE to the front ESP32, which drives the navigation LEDs
          and relays state to the rear ESP32 over Bluetooth Classic for the parking-aid strip.
        </p>
        <SystemDiagram lang="en" />
      </section>

      <section class="scenarios">
        <h2>Built for real driving</h2>
        <table>
          <thead>
            <tr>
              <th>Scenario</th>
              <th>LED effect</th>
            </tr>
          </thead>
          <tbody>
            {scenarios.map((s) => (
              <tr>
                <td>{s.scenario}</td>
                <td>{s.effect}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section class="cta">
        <h2>Open hardware, open source.</h2>
        <p>
          MIT-licensed. Requires an original ESP32 (WROOM/WROVER) with simultaneous Bluetooth
          Classic and BLE support — two boards, WS2812B LED strips, three HC-SR04 ultrasonic
          sensors, and Flutter for the companion app.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={docsUrl}>Get Started</a>
          <a class="btn btn-secondary" href={repoUrl}>Source on GitHub</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>&copy; {year} AmbientNav — MIT License</span>
      <span class="footer-links">
        <a href={repoUrl}>GitHub</a>
        <a href={docsUrl}>Docs</a>
      </span>
    </footer>

    <style>
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-5) var(--space-6);
        border-bottom: 1px solid var(--amb-line);
      }
      .brand img { display: block; }
      .site-nav { display: flex; gap: var(--space-6); }
      .site-nav a {
        color: var(--amb-text-3);
        text-decoration: none;
        font-size: 0.9rem;
      }
      .site-nav a:hover { color: var(--amb-cyan-soft); }

      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 var(--space-6) var(--space-8);
      }

      .hero {
        text-align: center;
        padding: var(--space-8) 0 var(--space-6);
      }
      .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--amb-cyan-soft);
        margin: 0 0 var(--space-4);
      }
      .hero h1 {
        font-size: clamp(2rem, 5vw, 3.2rem);
        line-height: 1.1;
        margin: 0 0 var(--space-5);
      }
      .hero-sub {
        max-width: 640px;
        margin: 0 auto var(--space-6);
        color: var(--amb-text-3);
        font-size: 1.05rem;
        line-height: 1.6;
      }
      .hero-actions {
        display: flex;
        gap: var(--space-4);
        justify-content: center;
        flex-wrap: wrap;
      }
      .btn {
        display: inline-block;
        padding: 0.7rem 1.4rem;
        border-radius: var(--radius-md);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
      }
      .btn-primary {
        background: var(--amb-gradient-h);
        color: var(--amb-cockpit);
        box-shadow: var(--amb-glow-cyan);
      }
      .btn-secondary {
        border: 1px solid var(--amb-line-strong);
        color: var(--amb-text);
      }

      section { padding: var(--space-8) 0; }
      section h2 {
        font-size: clamp(1.5rem, 3vw, 2rem);
        margin-bottom: var(--space-5);
        text-align: center;
      }
      .section-sub {
        max-width: 640px;
        margin: 0 auto var(--space-6);
        text-align: center;
        color: var(--amb-text-3);
      }

      .feature-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-5);
      }
      .feature-card {
        background: var(--amb-surface-2);
        border: 1px solid var(--amb-line);
        border-radius: var(--radius-lg);
        padding: var(--space-5);
        box-shadow: var(--shadow-card);
      }
      .feature-card h3 {
        font-size: 1.05rem;
        margin-bottom: var(--space-3);
      }
      .feature-card p { margin: 0; color: var(--amb-text-3); line-height: 1.55; }

      .scenarios table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
      }
      .scenarios th, .scenarios td {
        text-align: left;
        padding: var(--space-3) var(--space-4);
        border-bottom: 1px solid var(--amb-line);
      }
      .scenarios th { color: var(--amb-text-4); font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }

      .cta {
        text-align: center;
        border-top: 1px solid var(--amb-line);
      }
      .cta p {
        max-width: 620px;
        margin: 0 auto var(--space-6);
        color: var(--amb-text-3);
      }

      .site-footer {
        display: flex;
        justify-content: space-between;
        padding: var(--space-5) var(--space-6);
        border-top: 1px solid var(--amb-line);
        color: var(--amb-text-4);
        font-size: 0.85rem;
      }
      .footer-links { display: flex; gap: var(--space-4); }
      .footer-links a { color: var(--amb-text-4); text-decoration: none; }
      .footer-links a:hover { color: var(--amb-cyan-soft); }

      @media (max-width: 640px) {
        .feature-grid { grid-template-columns: 1fr; }
        .site-header { flex-direction: column; gap: var(--space-4); }
        .site-nav { gap: var(--space-4); flex-wrap: wrap; justify-content: center; }
        .site-footer { flex-direction: column; gap: var(--space-3); text-align: center; }
      }
    </style>
  </body>
</html>
