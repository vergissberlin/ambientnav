---
import HeroVisual from './HeroVisual.astro';
import CyberFrame from './CyberFrame.astro';

interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;

const t = {
  en: {
    eyebrow: '3D Preview',
    hint: 'Drag to rotate',
    all: 'All',
    guide: 'Guide',
    alert: 'Proximity',
    link: 'Link',
  },
  de: {
    eyebrow: '3D-Vorschau',
    hint: 'Ziehen zum Drehen',
    all: 'Alle',
    guide: 'Führung',
    alert: 'Nähe',
    link: 'Verbindung',
  },
}[lang];

const modes = [
  { key: 'all', label: t.all, color: null },
  { key: 'guide', label: t.guide, color: '#19E3FF' },
  { key: 'alert', label: t.alert, color: '#FF2D9C' },
  { key: 'link', label: t.link, color: '#7C5CFF' },
];
---

<div class="vv" data-vehicle-viewer>
  <CyberFrame as="div" class="vv-stage">
    <div class="vv-fallback" data-vv-fallback>
      <HeroVisual lang={lang} />
    </div>
    <div class="vv-canvas-wrap" data-vv-canvas-wrap aria-hidden="true">
      <canvas class="vv-canvas" data-vv-canvas></canvas>
    </div>
  </CyberFrame>
  <div class="vv-footer">
    <span class="vv-hint" data-vv-hint hidden>{t.hint}</span>
    <div class="vv-modes" data-vv-modes hidden role="group" aria-label="Feature focus">
      {modes.map((m) => (
        <button
          type="button"
          class="vv-mode-btn"
          data-vv-mode={m.key}
          aria-pressed={m.key === 'all' ? 'true' : 'false'}
        >
          {m.color && <i class="vv-dot" style={`background:${m.color};box-shadow:0 0 8px ${m.color}b3`}></i>}
          {m.label}
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .vv {
    margin: 2rem 0 2.5rem;
  }

  /* :global — CyberFrame renders this element inside its own component
     scope, so a plain `.vv-stage` selector no longer matches it. */
  :global(.vv-stage) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-frame, 2px);
    overflow: hidden;
    background: var(--amb-cockpit, #06080e);
    border: 1px solid var(--amb-line, rgba(255, 255, 255, 0.08));
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
  }

  .vv-fallback,
  .vv-canvas-wrap {
    position: absolute;
    inset: 0;
  }

  .vv-fallback :global(.hv) {
    margin: 0;
    height: 100%;
    border: none;
    border-radius: 0;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .vv-canvas-wrap {
    opacity: 0;
    transition: opacity 480ms ease;
    pointer-events: none;
  }
  .vv-canvas-wrap[data-ready='true'] {
    opacity: 1;
    pointer-events: auto;
  }

  .vv-canvas {
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y;
  }

  .vv-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }

  .vv-hint {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amb-text-4);
  }

  .vv-modes {
    display: flex;
    gap: var(--space-2);
    margin-left: auto;
  }
  .vv-mode-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--amb-text-3);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
    transition: all 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .vv-mode-btn:hover {
    background: var(--amb-surface-2);
    color: var(--amb-text);
  }
  .vv-mode-btn[aria-pressed='true'] {
    background: var(--amb-surface-3);
    border-color: var(--amb-line-strong);
    color: var(--amb-text);
  }
  .vv-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    display: inline-block;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    :global(.vv-stage) {
      aspect-ratio: 4 / 5;
    }
    .vv-modes {
      margin-left: 0;
      gap: var(--space-1);
      flex-wrap: wrap;
    }
  }
</style>

<script>
  import * as THREE from 'three';
  import { OBJLoader } from 'three/examples/jsm/loaders/OBJLoader.js';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';

  const CYAN = 0x19e3ff;
  const MAGENTA = 0xff2d9c;
  const VIOLET = 0x7c5cff;
  const NEUTRAL_DIM = 0x11141c;
  const IDLE_INTENSITY = 0.12;

  function orderedSegments(root: THREE.Object3D, prefix: string) {
    const items: { mesh: THREE.Mesh; index: number }[] = [];
    root.traverse((obj) => {
      if ((obj as THREE.Mesh).isMesh && obj.name.startsWith(prefix)) {
        const m = obj.name.match(/(\d+)$/);
        items.push({ mesh: obj as THREE.Mesh, index: m ? parseInt(m[1], 10) : 0 });
      }
    });
    items.sort((a, b) => a.index - b.index);
    return items.map((i) => i.mesh);
  }

  // Shortest wrap-around distance between two points on a [0,1) ring.
  function wrapDist(a: number, b: number) {
    const d = Math.abs(a - b);
    return Math.min(d, 1 - d);
  }

  function gaussian(x: number, width: number) {
    return Math.exp(-(x * x) / (2 * width * width));
  }

  async function init(root: HTMLElement) {
    if (!window.WebGLRenderingContext) return; // no WebGL — keep the 2D fallback

    const stage = root.querySelector<HTMLElement>('.vv-stage');
    const wrap = root.querySelector<HTMLElement>('[data-vv-canvas-wrap]');
    const canvas = root.querySelector<HTMLCanvasElement>('[data-vv-canvas]');
    const hint = root.querySelector<HTMLElement>('[data-vv-hint]');
    const fallback = root.querySelector<HTMLElement>('[data-vv-fallback]');
    const modesEl = root.querySelector<HTMLElement>('[data-vv-modes]');
    if (!stage || !wrap || !canvas) return;

    type Mode = 'all' | 'guide' | 'alert' | 'link';
    let activeMode: Mode = 'all';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setClearColor(0x000000, 0);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);

    // Neon-noir atmosphere: a dim, cool key so the signal-hued rim/fill/uplight
    // read as the dominant color story, plus depth haze in the cockpit hue.
    scene.fog = new THREE.Fog(0x06080e, 6, 22);

    scene.add(new THREE.AmbientLight(0x3a4256, 0.6));
    const key = new THREE.DirectionalLight(0xaebedd, 2.2);
    key.position.set(4, 5, 6);
    scene.add(key);
    const rim = new THREE.DirectionalLight(VIOLET, 0.85);
    rim.position.set(-5, 3, -4);
    scene.add(rim);
    const fill = new THREE.DirectionalLight(MAGENTA, 0.55);
    fill.position.set(-2, -1, 5);
    scene.add(fill);
    // Street-level cyan uplight — the "reflected neon signage" trope.
    const uplight = new THREE.PointLight(CYAN, 6, 10, 2);
    uplight.position.set(0.5, -0.6, 2.2);
    scene.add(uplight);

    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));
    const bloom = new UnrealBloomPass(new THREE.Vector2(1, 1), 0.8, 0.45, 0.28);
    composer.addPass(bloom);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.enableZoom = false;
    controls.enablePan = false;
    controls.minPolarAngle = Math.PI * 0.28;
    controls.maxPolarAngle = Math.PI * 0.52;
    controls.autoRotate = !reducedMotion;
    controls.autoRotateSpeed = 0.7;

    let userInteracting = false;
    let resumeTimer: number | undefined;
    canvas.addEventListener('pointerdown', () => {
      userInteracting = true;
      controls.autoRotate = false;
      if (hint) hint.hidden = true;
      window.clearTimeout(resumeTimer);
    });
    window.addEventListener('pointerup', () => {
      if (!userInteracting) return;
      userInteracting = false;
      resumeTimer = window.setTimeout(() => {
        if (activeMode === 'all') controls.autoRotate = !reducedMotion;
      }, 2200);
    });

    // Weathered graphite paint — matte enough to read as gritty street hardware
    // rather than a showroom finish, with just enough clearcoat to catch the
    // neon rim/fill as hard specular streaks.
    const paintMat = new THREE.MeshPhysicalMaterial({
      color: 0x22252d,
      metalness: 0.7,
      roughness: 0.5,
      clearcoat: 0.55,
      clearcoatRoughness: 0.35,
    });
    const glassMat = new THREE.MeshStandardMaterial({
      color: 0x090b11,
      roughness: 0.1,
      metalness: 0.2,
      transparent: true,
      // Kept more transparent than the neon-noir pass's 0.6 — the guide
      // strip sits right at the windshield base and needs to read as an
      // interior light glowing through the glass, not exterior trim.
      opacity: 0.3,
      depthWrite: false,
    });
    const tireMat = new THREE.MeshStandardMaterial({ color: 0x0a0a0a, roughness: 0.9 });
    // Sharper, near-mirror chrome for the rims — the polished-metal accent
    // the reference cyberpunk look leans on.
    const rimMat = new THREE.MeshStandardMaterial({ color: 0xc7ced8, roughness: 0.12, metalness: 0.95 });
    const housingMat = new THREE.MeshStandardMaterial({ color: 0x14161c, roughness: 0.45, metalness: 0.4 });
    const obstacleMat = new THREE.MeshStandardMaterial({
      color: 0x3a4050,
      roughness: 0.8,
      transparent: true,
      opacity: 0.85,
      emissive: MAGENTA,
      emissiveIntensity: 0.08,
    });
    function pingMaterial() {
      return new THREE.MeshBasicMaterial({
        color: MAGENTA,
        transparent: true,
        opacity: 0,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        side: THREE.DoubleSide,
      });
    }

    function ledMaterial(colorHex: number) {
      return new THREE.MeshStandardMaterial({
        color: colorHex,
        emissive: colorHex,
        emissiveIntensity: 0.25,
        roughness: 0.4,
        transparent: true,
        opacity: 1,
      });
    }

    let guideSegs: THREE.Mesh[] = [];
    let alertSegs: THREE.Mesh[] = [];
    let linkSegs: THREE.Mesh[] = [];
    let frontRings: THREE.Mesh[][] = [];
    let frontObstacle: THREE.Mesh | null = null;
    let rearRings: THREE.Mesh[][] = [];
    let rearObstacle: THREE.Mesh | null = null;

    try {
      const loader = new OBJLoader();
      const model = await loader.loadAsync('/models/ambientnav-vehicle.obj');

      guideSegs = orderedSegments(model, 'guide_strip_seg_');
      alertSegs = orderedSegments(model, 'alert_strip_seg_');
      linkSegs = orderedSegments(model, 'link_strip_seg_');
      guideSegs.forEach((mesh) => (mesh.material = ledMaterial(CYAN)));
      alertSegs.forEach((mesh) => (mesh.material = ledMaterial(MAGENTA)));
      linkSegs.forEach((mesh) => (mesh.material = ledMaterial(VIOLET)));

      // Front sensor-ping rings: grouped 3-per-sensor (wave_<sensor>_<ring>),
      // each ring gets its own material clone so rings at different phases
      // of the same ping can fade independently.
      for (let s = 1; s <= 4; s++) {
        const rings: THREE.Mesh[] = [];
        for (let r = 1; r <= 3; r++) {
          const mesh = model.getObjectByName(`wave_${s}_${r}`) as THREE.Mesh | null;
          if (mesh) {
            mesh.material = pingMaterial();
            rings.push(mesh);
          }
        }
        if (rings.length) frontRings.push(rings);
      }

      model.traverse((obj) => {
        if (!(obj as THREE.Mesh).isMesh) return;
        const mesh = obj as THREE.Mesh;
        const name = mesh.name;
        if (name === 'body_shell' || name === 'sill_left' || name === 'sill_right') mesh.material = paintMat;
        else if (name === 'glass_greenhouse') mesh.material = glassMat;
        else if (name.startsWith('wheel_')) mesh.material = tireMat;
        else if (name.startsWith('rim_')) mesh.material = rimMat;
        else if (name.startsWith('sensor_front_')) mesh.material = housingMat;
        else if (name === 'obstacle') {
          mesh.material = obstacleMat;
          frontObstacle = mesh;
        }
      });

      // Bounding boxes for the per-feature close-up views, computed in the
      // model's original (pre-recenter) space so they share a coordinate
      // system with `carBox` below.
      function boxOf(meshes: THREE.Mesh[]) {
        const box = new THREE.Box3();
        meshes.forEach((m) => box.expandByObject(m));
        return box;
      }
      const guideBox = boxOf(guideSegs);
      const alertBox = boxOf(alertSegs);
      const linkBox = boxOf(linkSegs);

      // The source model only ships a sensor+obstacle assembly at the
      // front; procedurally mirror it at the rear (next to the link strip)
      // so the demo shows both ends' distance sensors, matching the real
      // product's rear-mounted parking sensors.
      const linkZMin = linkBox.min.z;
      const linkZSpan = linkBox.max.z - linkBox.min.z;
      const rearX = linkBox.min.x - 0.12;
      const rearY = 0.42;
      [0.18, 0.5, 0.82].forEach((f) => {
        const z = linkZMin + linkZSpan * f;
        const puck = new THREE.Mesh(new THREE.SphereGeometry(0.035, 12, 8), housingMat);
        puck.position.set(rearX, rearY, z);
        model.add(puck);

        const rings: THREE.Mesh[] = [];
        for (let r = 0; r < 3; r++) {
          const ring = new THREE.Mesh(new THREE.RingGeometry(0.02, 0.05, 24), pingMaterial());
          ring.rotation.y = -Math.PI / 2;
          ring.position.set(rearX - 0.01, rearY, z);
          model.add(ring);
          rings.push(ring);
        }
        rearRings.push(rings);
      });
      rearObstacle = new THREE.Mesh(new THREE.BoxGeometry(0.14, 0.5, 1.5), obstacleMat.clone());
      rearObstacle.name = 'obstacle';
      rearObstacle.position.set(rearX - 0.85, 0.25, linkZMin + linkZSpan * 0.5);
      model.add(rearObstacle);

      // Frame the car with a flattering 3/4 angle, centred on its midsection.
      // The obstacle prop sits well beyond the car's own silhouette — leave
      // it out of the framing box so the default overview stays a shot of
      // the car, not a shot of the car-plus-a-wall.
      const carBox = new THREE.Box3();
      model.traverse((obj) => {
        if ((obj as THREE.Mesh).isMesh && obj.visible && obj.name !== 'obstacle') carBox.expandByObject(obj);
      });
      const center = carBox.getCenter(new THREE.Vector3());
      const size = carBox.getSize(new THREE.Vector3());
      const radius = Math.max(size.x, size.y, size.z) * 0.5;

      model.position.sub(center);
      controls.target.set(0, size.y * 0.38, 0);
      const dist = (radius / Math.sin((camera.fov * Math.PI) / 360)) * 0.86;
      camera.position.set(dist * 0.62, dist * 0.42, dist * 0.72);
      camera.lookAt(controls.target);
      controls.update();

      const defaultView = { pos: camera.position.clone(), target: controls.target.clone() };
      function focusView(box: THREE.Box3) {
        const c = box.getCenter(new THREE.Vector3()).sub(center);
        const s = box.getSize(new THREE.Vector3());
        const r = Math.max(s.x, s.y, s.z, 0.12);
        // Approach from outside the car body on whichever end (front/rear)
        // this feature sits on, not a fixed direction — a rear feature
        // needs the camera behind the car, not hovering over the middle.
        const xSign = c.x >= 0 ? 1 : -1;
        const off = new THREE.Vector3(0.9 * xSign, 0.5, 0.85).normalize();
        const d = r * 3.2 + 1.1;
        return { pos: c.clone().addScaledVector(off, d), target: c.clone() };
      }
      // The Proximity/Link close-ups should frame the sensor hardware too,
      // not just the light strip — union in the sensor housings, ping
      // rings, and obstacle so clicking the button brings the whole
      // "sensor sees an obstacle" story into view.
      const alertFocusBox = alertBox.clone();
      if (frontObstacle) alertFocusBox.expandByObject(frontObstacle);
      model.traverse((obj) => {
        if ((obj as THREE.Mesh).isMesh && obj.name.startsWith('sensor_front_')) alertFocusBox.expandByObject(obj);
      });
      frontRings.forEach((rings) => rings.forEach((r) => alertFocusBox.expandByObject(r)));

      const linkFocusBox = linkBox.clone();
      if (rearObstacle) linkFocusBox.expandByObject(rearObstacle);
      rearRings.forEach((rings) => rings.forEach((r) => linkFocusBox.expandByObject(r)));

      const focusViews: Record<Mode, { pos: THREE.Vector3; target: THREE.Vector3 }> = {
        all: defaultView,
        guide: focusView(guideBox),
        alert: focusView(alertFocusBox),
        link: focusView(linkFocusBox),
      };

      // Unfocused strips fade to the car's neutral trim colour, not just a
      // lower emissive intensity — emissive alone still reads as a tinted
      // surface under the key/rim lights, which doesn't read as "off".
      function setStripFocus(segs: THREE.Mesh[], colorHex: number, focused: boolean) {
        segs.forEach((m) => {
          const mat = m.material as THREE.MeshStandardMaterial;
          mat.color.setHex(focused ? colorHex : NEUTRAL_DIM);
          if (!focused) mat.emissiveIntensity = IDLE_INTENSITY;
        });
      }
      function applyMode(mode: Mode) {
        setStripFocus(guideSegs, CYAN, mode === 'all' || mode === 'guide');
        setStripFocus(alertSegs, MAGENTA, mode === 'all' || mode === 'alert');
        setStripFocus(linkSegs, VIOLET, mode === 'all' || mode === 'link');
      }

      const modeButtons = modesEl
        ? Array.from(modesEl.querySelectorAll<HTMLButtonElement>('[data-vv-mode]'))
        : [];
      modeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.dataset.vvMode as Mode;
          if (mode === activeMode) return;
          activeMode = mode;
          modeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          applyMode(mode);
          tweenTo(focusViews[mode].pos, focusViews[mode].target, 750);
          controls.autoRotate = mode === 'all' && !reducedMotion;
        });
      });

      scene.add(model);
    } catch (err) {
      console.warn('[vehicle-viewer] failed to load model, keeping 2D fallback', err);
      return;
    }

    let tween: {
      fromPos: THREE.Vector3;
      toPos: THREE.Vector3;
      fromTarget: THREE.Vector3;
      toTarget: THREE.Vector3;
      t0: number;
      dur: number;
    } | null = null;
    function tweenTo(pos: THREE.Vector3, target: THREE.Vector3, dur = 700) {
      tween = {
        fromPos: camera.position.clone(),
        toPos: pos.clone(),
        fromTarget: controls.target.clone(),
        toTarget: target.clone(),
        t0: performance.now(),
        dur,
      };
    }

    function resize() {
      const w = stage!.clientWidth;
      const h = stage!.clientHeight;
      if (!w || !h) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h, false);
      composer.setSize(w, h);
    }
    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(stage);
    resize();

    let visible = true;
    const intersectionObserver = new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? true;
      },
      { threshold: 0.05 },
    );
    intersectionObserver.observe(stage);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) visible = false;
      else intersectionObserver.observe(stage);
    });

    const GUIDE_CYCLE_MS = 20000;
    const GUIDE_FOCUS_CYCLE_MS = 6500;
    const ALERT_PERIOD_MS = 9000;
    const ALERT_FOCUS_PERIOD_MS = 4000;
    const LINK_LOOP_MS = 2200;
    const clock = new THREE.Clock();
    let elapsed = 0;

    function animateGuide() {
      const n = guideSegs.length;
      if (!n) return;
      if (activeMode !== 'all' && activeMode !== 'guide') return;
      const cycle = activeMode === 'guide' ? GUIDE_FOCUS_CYCLE_MS : GUIDE_CYCLE_MS;
      const t = (elapsed % cycle) / cycle;
      const breathe = 0.28 + 0.14 * Math.sin(elapsed / 1400);

      for (let i = 0; i < n; i++) {
        const ratio = i / (n - 1);
        let intensity = breathe * 0.6;

        if (t >= 0.15 && t < 0.4) {
          // Sweep toward the high-index end.
          const progress = (t - 0.15) / 0.25;
          intensity = Math.max(intensity, 0.25 + 1.1 * gaussian(ratio - progress, 0.16));
        } else if (t >= 0.42 && t < 0.62) {
          // Sweep toward the low-index end.
          const progress = 1 - (t - 0.42) / 0.2;
          intensity = Math.max(intensity, 0.25 + 1.1 * gaussian(ratio - progress, 0.16));
        } else if (t >= 0.64 && t < 0.8) {
          // Symmetric centre-out pulse.
          intensity = Math.max(intensity, 0.3 + 1.0 * gaussian(ratio - 0.5, 0.22));
        }

        (guideSegs[i].material as THREE.MeshStandardMaterial).emissiveIntensity = intensity;
      }
    }

    function distanceRatio() {
      // 0 = obstacle very close, 1 = far.
      const period = activeMode === 'alert' ? ALERT_FOCUS_PERIOD_MS : ALERT_PERIOD_MS;
      return (Math.sin(elapsed / period - Math.PI / 2) + 1) / 2;
    }

    function animateAlert() {
      const n = alertSegs.length;
      if (!n) return;
      if (activeMode !== 'all' && activeMode !== 'alert') return;
      const d = distanceRatio();
      const lit = Math.round((1 - d) * (n / 2));
      const closePulse = d < 0.14 ? 0.5 + 0.5 * Math.sin(elapsed / 130) : 0;

      for (let i = 0; i < n; i++) {
        const distFromEdge = Math.min(i, n - 1 - i);
        const base = distFromEdge <= lit ? 0.9 : 0.15;
        const mat = alertSegs[i].material as THREE.MeshStandardMaterial;
        mat.emissiveIntensity = Math.max(base, closePulse);
      }
    }

    function animateLink() {
      const n = linkSegs.length;
      if (!n) return;
      if (activeMode !== 'all' && activeMode !== 'link') return;
      const pos = (elapsed % LINK_LOOP_MS) / LINK_LOOP_MS;
      for (let i = 0; i < n; i++) {
        const ratio = i / (n - 1);
        const intensity = 0.18 + 0.85 * gaussian(wrapDist(ratio, pos), 0.1);
        (linkSegs[i].material as THREE.MeshStandardMaterial).emissiveIntensity = intensity;
      }
    }

    // Rear sensors run on their own clock, out of phase with the front —
    // two independent systems, not a mirrored pair ticking in lockstep.
    const REAR_PHASE_OFFSET_MS = 4500;
    function rearDistanceRatio() {
      return (Math.sin((elapsed + REAR_PHASE_OFFSET_MS) / ALERT_PERIOD_MS - Math.PI / 2) + 1) / 2;
    }

    function animatePingRings(rings: THREE.Mesh[][], d: number) {
      const speed = 0.55 + (1 - d) * 1.1;
      const dur = 1800 / speed;
      rings.forEach((ring) => {
        ring.forEach((mesh, r) => {
          const phase = ((elapsed + r * (dur / 3)) % dur) / dur;
          mesh.scale.setScalar(0.7 + phase * 0.9);
          (mesh.material as THREE.MeshBasicMaterial).opacity = 0.7 * (1 - phase) * (0.4 + 0.6 * (1 - d));
        });
      });
    }

    function setRingsVisible(rings: THREE.Mesh[][], v: boolean) {
      rings.forEach((r) => r.forEach((mesh) => (mesh.visible = v)));
    }

    function animateSensors() {
      // The obstacle walls + ping rings tell a "sensor detects a wall"
      // story that only makes sense up close — shown only while that end
      // is focused, so the default overview and the other feature's
      // close-up stay uncluttered.
      const frontActive = activeMode === 'alert';
      setRingsVisible(frontRings, frontActive);
      if (frontObstacle) frontObstacle.visible = frontActive;
      if (frontActive) {
        const df = distanceRatio();
        animatePingRings(frontRings, df);
        if (frontObstacle) {
          const closePulse = df < 0.14 ? 0.5 + 0.5 * Math.sin(elapsed / 130) : 0;
          (frontObstacle.material as THREE.MeshStandardMaterial).emissiveIntensity =
            0.08 + (1 - df) * 0.55 + closePulse * 0.3;
        }
      }

      const rearActive = activeMode === 'link';
      setRingsVisible(rearRings, rearActive);
      if (rearObstacle) rearObstacle.visible = rearActive;
      if (rearActive) {
        const dr = rearDistanceRatio();
        animatePingRings(rearRings, dr);
        if (rearObstacle) {
          const closePulse = dr < 0.14 ? 0.5 + 0.5 * Math.sin(elapsed / 130 + 1.7) : 0;
          (rearObstacle.material as THREE.MeshStandardMaterial).emissiveIntensity =
            0.08 + (1 - dr) * 0.55 + closePulse * 0.3;
        }
      }
    }

    function tick() {
      requestAnimationFrame(tick);
      const dt = clock.getDelta();
      if (!visible) return;
      elapsed += dt * 1000 * (reducedMotion ? 0.15 : 1);

      if (tween) {
        const k = Math.min(1, (performance.now() - tween.t0) / tween.dur);
        const e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
        camera.position.lerpVectors(tween.fromPos, tween.toPos, e);
        controls.target.lerpVectors(tween.fromTarget, tween.toTarget, e);
        if (k >= 1) tween = null;
      }

      animateGuide();
      animateAlert();
      animateLink();
      animateSensors();

      controls.update();
      composer.render();
    }
    tick();

    wrap.dataset.ready = 'true';
    wrap.setAttribute('aria-hidden', 'false');
    if (hint) hint.hidden = false;
    if (modesEl) modesEl.hidden = false;
    if (fallback) fallback.style.display = 'none';
  }

  document.querySelectorAll<HTMLElement>('[data-vehicle-viewer]').forEach((el) => {
    const start = () => init(el).catch((err) => console.warn('[vehicle-viewer] init failed', err));
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(start, { timeout: 1500 });
    } else {
      window.setTimeout(start, 200);
    }
  });
</script>
